# 复制为 .env 后填写。不要将真实密钥提交到仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# false 使用真实模型；true 使用明确标记的本地固定流程演示，不调用大模型。
AGENT_DEMO_MODE=false
PORT=3100
WEB_PORT=5173
# 可选 OpenAI Responses；在 resources/workers/analyst.yaml 中改 modelId。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 可选：自定义 MCP 服务凭证，通过 config/mcp.yaml 的 env 引用使用。默认示例无需凭证。
MCP_DOCS_TOKEN=
